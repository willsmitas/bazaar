# ================================================================
#  Bazaar — environment variables
#
#  LOCAL DEV:  copy this file to .env and fill in your values.
#  PRODUCTION: set these as environment variables on your hosting
#              platform (Railway / Render / Heroku / Fly.io).
#              Do NOT commit a .env file with real secrets.
# ================================================================


# ── Database ─────────────────────────────────────────────────────
#
# Local Postgres (install from postgresql.org, then create a 'bazaar' db):
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bazaar
#
# Cloud options — uncomment one when deploying:
# DATABASE_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres          # Supabase
# DATABASE_URL=postgresql://<user>:<pw>@<host>.neon.tech/bazaar?sslmode=require       # Neon
# DATABASE_URL=postgresql://postgres:<pw>@<host>.railway.app:5432/railway             # Railway
# DATABASE_URL=postgresql://<user>:<pw>@<host>.rds.amazonaws.com:5432/bazaar         # AWS RDS


# ── Auth ─────────────────────────────────────────────────────────
#
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying


# ── Image storage ─────────────────────────────────────────────────
#
# Dev — files saved to uploads/ on disk:
STORAGE_BACKEND=local
LOCAL_BASE_URL=http://localhost:8000
#
# Prod — switch to S3 (also set the three vars below):
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=bazaar-images
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ── Auth tokens ──────────────────────────────────────────────────
#
# How long tokens stay valid.  Defaults are 7-day access + 30-day refresh.
# ACCESS_TOKEN_TTL_MINUTES=10080
# REFRESH_TOKEN_TTL_DAYS=30


# ── Email (SMTP) ──────────────────────────────────────────────────
#
# Dev: leave SMTP_HOST blank (or omit it entirely).
#      Verification and reset codes will be printed to the server console.
#
# Prod: set these to your provider's values.
#
#   Gmail      → SMTP_HOST=smtp.gmail.com  (use an App Password, not your account password)
#   SendGrid   → SMTP_HOST=smtp.sendgrid.net  SMTP_USERNAME=apikey  SMTP_PASSWORD=<api-key>
#   Mailgun    → SMTP_HOST=smtp.mailgun.org
#   AWS SES    → SMTP_HOST=email-smtp.<region>.amazonaws.com
#
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@bazaar.app


# ── Payments (Stripe) ──
#
# Leave blank to run Bazaar without payments (the payment endpoints return 503).
#
# Dev setup:
#   1. Grab your TEST keys from https://dashboard.stripe.com/test/apikeys
#   2. Run the Stripe CLI to forward webhooks to your local server:
#        stripe listen --forward-to localhost:8000/payments/webhook
#      It prints a signing secret (whsec_…) — put it in STRIPE_WEBHOOK_SECRET.
#   3. Connect onboarding/refunds/transfers all work against test data.
#
# Prod: swap in your live keys (sk_live_… / pk_live_…) and set the webhook
# secret from the endpoint you create in the Stripe dashboard. Also requires
# Stripe Connect to be enabled on your account.
#
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Connect onboarding sends the seller back to (your app's URL):
PUBLIC_BASE_URL=http://localhost:8000


# ── Server ────────────────────────────────────────────────────────
#
# Dev — allow all origins and show /docs:
CORS_ORIGINS=*
DEBUG=true
#
# Prod — lock down to your real domain and disable debug:
# CORS_ORIGINS=https://bazaar.app,https://www.bazaar.app
# DEBUG=false
